# Preferred API port. If taken, the server tries 3001, 3002, …
PORT=3000

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://edupass:edupass@localhost:5434/edupass_dev?schema=public"

# Auth
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"

# CORS (comma-separated)
CORS_ORIGINS="http://localhost:5174,http://localhost:5173"

# Feature flags
PAYHERE_ENABLED=false

# SMTP (optional — without SMTP_HOST, emails are logged only)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="EduPass <noreply@edupass.lk>"

# Seed: set false in production to skip sample users/seminars (plans/bank/categories always seeded)
# SEED_QA=false
